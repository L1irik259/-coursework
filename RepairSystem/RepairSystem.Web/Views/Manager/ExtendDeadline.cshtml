@using RepairSystem.Core.Models
@model Request
@{ ViewData["Title"] = "Продление срока"; Layout = "_Layout"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h5>📅 Продление срока — @Model.Number</h5>
                <dl class="row mt-3">
                    <dt class="col-sm-5">Оборудование</dt>
                    <dd class="col-sm-7">@Model.Equipment.Name</dd>
                    <dt class="col-sm-5">Клиент</dt>
                    <dd class="col-sm-7">@Model.Client.FullName</dd>
                    <dt class="col-sm-5">Текущий дедлайн</dt>
                    <dd class="col-sm-7">@(Model.Deadline?.ToString("dd.MM.yyyy") ?? "не задан")</dd>
                </dl>
                <form method="post" asp-action="ExtendDeadline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="requestId" value="@Model.RequestId" />
                    <div class="mb-3">
                        <label class="form-label">Новый дедлайн <span class="text-danger">*</span></label>
                        <input name="newDeadline" type="date" class="form-control" required min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Основание (согласование с клиентом) <span class="text-danger">*</span></label>
                        <textarea name="agreementNote" class="form-control" rows="3" placeholder="Запись факта согласования с клиентом..." required></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Подтвердить продление</button>
                        <a asp-controller="Request" asp-action="Details" asp-route-id="@Model.RequestId" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
