@using RepairSystem.Core.DTOs
@model StatisticsDto
@{ ViewData["Title"] = "Статистика"; Layout = "_Layout"; }

<h4 class="mb-4">📊 Статистика работы отдела</h4>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <label class="form-label small">С</label>
        <input name="from" type="date" class="form-control" value="@ViewBag.From" />
    </div>
    <div class="col-md-3">
        <label class="form-label small">По</label>
        <input name="to" type="date" class="form-control" value="@ViewBag.To" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Применить</button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center shadow-sm border-0 bg-primary text-white">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.TotalRequests</div>
                <div class="small">Всего заявок</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm border-0 bg-success text-white">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.CompletedRequests</div>
                <div class="small">Выполнено</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm border-0 bg-info text-white">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.ActiveRequests</div>
                <div class="small">В работе</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm border-0 bg-secondary text-white">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.AverageCompletionHours ч</div>
                <div class="small">Среднее время</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header">Заявки по месяцам</div>
            <div class="card-body">
                <canvas id="monthlyChart" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header">Типы неисправностей</div>
            <div class="card-body">
                <canvas id="faultChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="card shadow-sm">
            <div class="card-header">Среднее время выполнения по месяцам (часов)</div>
            <div class="card-body">
                <canvas id="avgTimeChart" height="80"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const monthly = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyStats));
const faults  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FaultTypeStats));

new Chart(document.getElementById('monthlyChart'), {
    type: 'bar',
    data: {
        labels: monthly.map(m => m.monthName),
        datasets: [{
            label: 'Количество заявок',
            data: monthly.map(m => m.count),
            backgroundColor: 'rgba(13,110,253,.7)',
            borderRadius: 4
        }]
    },
    options: { plugins: { legend: { display: false } } }
});

new Chart(document.getElementById('faultChart'), {
    type: 'doughnut',
    data: {
        labels: faults.map(f => f.faultType),
        datasets: [{ data: faults.map(f => f.count), hoverOffset: 4 }]
    }
});

new Chart(document.getElementById('avgTimeChart'), {
    type: 'line',
    data: {
        labels: monthly.map(m => m.monthName),
        datasets: [{
            label: 'Среднее время (ч)',
            data: monthly.map(m => m.avgCompletionHours.toFixed(1)),
            borderColor: 'rgba(25,135,84,1)',
            backgroundColor: 'rgba(25,135,84,.1)',
            fill: true,
            tension: 0.3
        }]
    }
});
</script>
}
