<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Техносервис</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .navbar-brand { font-weight: 700; letter-spacing: .5px; }
        .badge-bell { position: relative; }
        .badge-bell .badge { position: absolute; top: -6px; right: -8px; font-size: .65rem; }
        .status-pending  { background: #ffc107; color: #000; }
        .status-inprog   { background: #0d6efd; color: #fff; }
        .status-done     { background: #198754; color: #fff; }
        .notification-dot { width: 8px; height: 8px; background: #dc3545; border-radius: 50%; display: inline-block; }
    </style>
</head>
<body class="bg-light">
<header>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">🔧 Техносервис</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole("Клиент"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Request" asp-action="Index">Мои заявки</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Request" asp-action="Create">Новая заявка</a>
                            </li>
                        }
                        @if (User.IsInRole("Исполнитель"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Request" asp-action="Assigned">Мои заявки</a>
                            </li>
                        }
                        @if (User.IsInRole("Менеджер"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Manager" asp-action="All">Все заявки</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Управление</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="User" asp-action="Index">Пользователи</a></li>
                                    <li><a class="dropdown-item" asp-controller="Equipment" asp-action="Index">Оборудование</a></li>
                                    <li><hr class="dropdown-divider"/></li>
                                    <li><a class="dropdown-item" asp-controller="Statistics" asp-action="Index">Статистика</a></li>
                                    <li><a class="dropdown-item" asp-controller="Settings" asp-action="QrForm">Настройки QR</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item me-3 badge-bell" id="notificationBell">
                            <a class="nav-link text-white" href="#" data-bs-toggle="offcanvas" data-bs-target="#notifPanel">
                                🔔 <span class="badge bg-danger" id="notifCount" style="display:none">0</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <span class="navbar-text text-light me-3">@User.Identity.Name</span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">Выйти</a>
                        </li>
                    </ul>
                }
                else
                {
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Войти</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">Регистрация</a>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>
</header>

<!-- Offcanvas уведомлений -->
<div class="offcanvas offcanvas-end" id="notifPanel" style="width:380px">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Уведомления</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0">
        <div class="d-flex justify-content-end px-3 pt-2">
            <button class="btn btn-sm btn-outline-secondary" id="markAllRead">Прочитать все</button>
        </div>
        <div id="notifList" class="list-group list-group-flush mt-2"></div>
    </div>
</div>

<div class="container pb-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <main>@RenderBody()</main>
</div>

<footer class="bg-dark text-light py-3 mt-5">
    <div class="container text-center small">ООО «Техносервис» © @DateTime.Now.Year</div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@if (User.Identity?.IsAuthenticated == true)
{
    <script>
    function loadNotifications() {
        fetch('/Notification/GetUnread')
            .then(r => r.json())
            .then(data => {
                const count = data.length;
                const badge = document.getElementById('notifCount');
                if (count > 0) { badge.textContent = count; badge.style.display = 'inline'; }
                else { badge.style.display = 'none'; }

                const list = document.getElementById('notifList');
                list.innerHTML = data.length === 0
                    ? '<p class="text-muted text-center p-3">Нет новых уведомлений</p>'
                    : data.map(n => `
                        <div class="list-group-item list-group-item-action" data-id="${n.notificationId}">
                            <small class="text-muted">${new Date(n.createdAt).toLocaleString('ru')}</small>
                            <div>${n.message}</div>
                            ${n.requestId ? `<a href="/Request/Details/${n.requestId}" class="small text-primary">Открыть заявку →</a>` : ''}
                        </div>`).join('');

                list.querySelectorAll('.list-group-item').forEach(el => {
                    el.addEventListener('click', () => {
                        fetch('/Notification/MarkRead/' + el.dataset.id, { method: 'POST', headers: {'RequestVerificationToken': document.querySelector('input[name=__RequestVerificationToken]')?.value || ''} });
                        el.remove();
                    });
                });
            });
    }
    loadNotifications();
    setInterval(loadNotifications, 30000);

    document.getElementById('markAllRead')?.addEventListener('click', () => {
        fetch('/Notification/MarkAllRead', { method: 'POST' }).then(loadNotifications);
    });
    </script>
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
