@using RepairSystem.Core.Models
@model IEnumerable<Equipment>
@{ ViewData["Title"] = "Оборудование"; Layout = "_Layout"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>🖥️ Оборудование</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">+ Добавить</button>
</div>

<div class="table-responsive">
    <table class="table table-hover bg-white shadow-sm rounded">
        <thead class="table-dark">
            <tr><th>Название</th><th>Серийный номер</th><th>Описание</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Name</td>
                    <td>@e.SerialNumber</td>
                    <td>@(e.Description ?? "—")</td>
                    <td>
                        <form method="post" asp-action="Delete">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@e.EquipmentId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Удалить?')">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Добавить оборудование</h5></div>
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            { <div>@err.ErrorMessage</div> }
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label">Название *</label>
                        <input name="name" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Серийный номер *</label>
                        <input name="serialNumber" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Описание</label>
                        <input name="description" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Добавить</button>
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                </div>
            </form>
        </div>
    </div>
</div>
