<Window x:Class="FranchAdm.FranchiseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Франшиза" 
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="lblTitle" 
                   Grid.Row="0" 
                   Text="Добавление франшизы" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#2D3436" 
                   Margin="0,0,0,20"/>

        <!-- Основная форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка - Основные поля -->
                <StackPanel Grid.Column="0">

                    <!-- Название -->
                    <TextBlock Text="Название *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtName" 
                             Padding="10,8" 
                             BorderBrush="#DFE6E9" BorderThickness="1"
                             FontSize="14"
                             MaxLength="100"
                             Margin="0,0,0,15"/>
                    
                    

                    <!-- Описание -->
                    <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtDescription" 
                             Padding="10,8" 
                             BorderBrush="#DFE6E9" BorderThickness="1"
                             FontSize="14"
                             Height="100"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             MaxLength="250"
                             Margin="0,0,0,15"/>

                    <!-- Категория и Франчайзер -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Категория *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbCategory" 
                                      Padding="10,8" 
                                      FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Франчайзер *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbFranchiser" 
                                      Padding="10,8" 
                                      FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <!-- Тип франшизы и Статус -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Тип франшизы" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbFranType" 
                                      Padding="10,8" 
                                      FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Статус" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbFranStatus" 
                                      Padding="10,8" 
                                      FontSize="14"/>
                        </StackPanel>
                    </Grid>
                    <!-- Тип помещения -->
                    <TextBlock Text="Тип помещения" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbPremType" 
          Padding="10,8" 
          FontSize="14"
          Margin="0,0,0,15"/>
                    <!-- Теги -->
                    <TextBlock Text="Теги" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ListBox x:Name="lstTags" 
                             Height="80" 
                             BorderBrush="#DFE6E9" BorderThickness="1"
                             SelectionMode="Multiple"
                             Margin="0,0,0,15">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                </StackPanel>

                <!-- Правая колонка - Фото и Финансы -->
                <StackPanel Grid.Column="2">

                    <!-- Блок с фото -->
                    <Border Background="#DFE6E9" 
                            CornerRadius="8" 
                            Width="200" Height="200" 
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center">
                        <Grid>
                            <Image x:Name="imgPreview" 
                                   Stretch="UniformToFill" 
                                   Visibility="Collapsed"/>
                            <TextBlock x:Name="txtNoImage" 
                                       Text="Нет фото" 
                                       Foreground="#636E72" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       FontSize="14"/>
                        </Grid>
                    </Border>

                    <!-- Кнопка загрузки фото -->
                    <Button x:Name="btnUploadPhoto"
                            Content="📁 Загрузить фото" 
                            Background="#3B82F6" Foreground="White"
                            BorderThickness="0" Padding="10,8"
                            Cursor="Hand" Click="BtnUploadPhoto_Click"
                            Width="200" Margin="0,0,0,20"
                            HorizontalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Разделитель -->
                    <Separator Background="#DFE6E9" Margin="0,0,0,15"/>

                    <!-- Цена -->
                    <TextBlock Text="Цена (₽) *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFinalPrice" 
                             Padding="10,8" 
                             BorderBrush="#DFE6E9" BorderThickness="1"
                             FontSize="14"
                             MaxLength="100"
                             PreviewTextInput="TxtFinalPrice_PreviewTextInput"
                             Margin="0,0,0,15"/>

                    <!-- Инвестиции -->
                    <TextBlock Text="Инвестиции (₽)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtInvestmentAmount" 
                             Padding="10,8" 
                             BorderBrush="#DFE6E9" BorderThickness="1"
                             FontSize="14"
                             MaxLength="100"
                             PreviewTextInput="TxtInvestmentAmount_PreviewTextInput"
                             Margin="0,0,0,15"/>

                    <!-- Паушальный взнос -->
                    <TextBlock Text="Паушальный взнос (₽)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPledgeAmount" 
                             Padding="10,8" 
                             BorderBrush="#DFE6E9" BorderThickness="1"
                             FontSize="14"
                             MaxLength="100"
                             PreviewTextInput="TxtPledgeAmount_PreviewTextInput"
                             Margin="0,0,0,15"/>

                    <!-- Роялти -->
                    <TextBlock Text="Роялти (%)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtRoyaltyPercent" 
                             Padding="10,8" 
                             BorderBrush="#DFE6E9" BorderThickness="1"
                             FontSize="14"
                             MaxLength="100"
                             PreviewTextInput="TxtRoyaltyPercent_PreviewTextInput"
                             Margin="0,0,0,15"/>

                    <!-- Срок окупаемости -->
                    <TextBlock Text="Окупаемость (мес.)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPaybackPeriod" 
                             Padding="10,8" 
                             BorderBrush="#DFE6E9" BorderThickness="1"
                             FontSize="14"
                             MaxLength="10"
                             PreviewTextInput="TxtPaybackPeriod_PreviewTextInput"
                             Margin="0,0,0,15"/>

                    <!-- Скидка -->
                    <TextBlock Text="Скидка (%)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtDiscountPercent" 
                             Padding="10,8" 
                             BorderBrush="#DFE6E9" BorderThickness="1"
                             FontSize="14"
                             MaxLength="3"
                             PreviewTextInput="TxtDiscountPercent_PreviewTextInput"
                             Margin="0,0,0,15"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Инфо об изменении цены -->
        <Border x:Name="brdPriceHistory" 
                Grid.Row="1" VerticalAlignment="Bottom" 
                Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                CornerRadius="8" Padding="15" Margin="0,0,0,80"
                Visibility="Collapsed">
            <TextBlock>
                <Run Text="⚠️ Цена изменена с " FontWeight="SemiBold"/>
                <Run x:Name="txtOldPrice" FontWeight="Bold"/>
                <Run Text=" на "/>
                <Run x:Name="txtNewPrice" FontWeight="Bold"/>
                <Run Text=". Изменения будут сохранены в историю."/>
            </TextBlock>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    Background="#636E72" Foreground="White"
                    BorderThickness="0" Padding="20,10"
                    Margin="0,0,10,0"
                    Cursor="Hand" Click="BtnCancel_Click"
                    FontSize="14">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="💾 Сохранить" 
                    Background="#FF6B35" Foreground="White"
                    BorderThickness="0" Padding="20,10"
                    Cursor="Hand" Click="BtnSave_Click"
                    FontSize="14" FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>