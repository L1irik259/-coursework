<Window x:Class="FranchAdm.OrderStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменение статуса заявки" 
        Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите новый статус:" 
                   FontWeight="SemiBold" Margin="0,0,0,10" FontSize="14"/>

        <ComboBox x:Name="cmbStatus" 
                  Grid.Row="1" 
                  Padding="10,8" 
                  FontSize="14"
                  Margin="0,0,0,15"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="80" Padding="10,5"
                    Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Width="100" Padding="10,5"
                    Background="#FF6B35" Foreground="White"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>