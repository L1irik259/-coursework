<UserControl x:Class="FranchAdm.FranshiseListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка Добавить -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="btnAddFranchise" 
                    DockPanel.Dock="Right"
                    Content="➕ Добавить франшизу" 
                    Background="#FF6B35" Foreground="White" 
                    Padding="15,10" BorderThickness="0" 
                    FontSize="14" FontWeight="SemiBold" 
                    Cursor="Hand" Click="BtnAddFranchise_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <TextBlock Text="📦 Управление франшизами" 
                       FontSize="24" FontWeight="Bold" 
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Панель поиска и фильтров -->
        <Border Grid.Row="1" Background="White" 
                BorderBrush="#DFE6E9" BorderThickness="1" 
                CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <TextBox x:Name="txtSearch" 
                         Grid.Column="0"
                         Padding="10,8" 
                         BorderBrush="#DFE6E9" BorderThickness="1"
                         FontSize="14"
                         MaxLength="100"
                         TextChanged="TxtSearch_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Фильтр по категории -->
                <ComboBox x:Name="cmbCategory" 
                          Grid.Column="1" 
                          Margin="10,0,10,0"
                          Padding="10,8"
                          FontSize="14"
                          SelectionChanged="CmbCategory_SelectionChanged">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <!-- Фильтр по статусу -->
                <ComboBox x:Name="cmbStatus" 
                          Grid.Column="2" 
                          Margin="0,0,10,0"
                          Padding="10,8"
                          FontSize="14"
                          SelectionChanged="CmbStatus_SelectionChanged">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <!-- Кнопка сброса -->
                <Button Grid.Column="3" 
                        Content="🔄 Сброс" 
                        Background="#636E72" Foreground="White"
                        BorderThickness="0" Padding="10,8"
                        Cursor="Hand" Click="BtnReset_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ListView с франшизами -->
        <Border Grid.Row="2" Background="White" 
                BorderBrush="#DFE6E9" BorderThickness="1" 
                CornerRadius="8">
            <ListView x:Name="lvFranchises" 
                      BorderThickness="0" 
                      Background="Transparent"
                      SelectionMode="Single"
                      SelectionChanged="LvFranchises_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <!-- Фото -->
                        <GridViewColumn Header="Фото" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding MinPhotoUrl}" 
                                           Width="50" Height="50" 
                                           Stretch="UniformToFill" 
                                           Margin="5"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Название -->
                        <GridViewColumn Header="Название" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Категория -->
                        <GridViewColumn Header="Категория" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CategoryName}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Франчайзер -->
                        <GridViewColumn Header="Франчайзер" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FranchiserName}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Цена -->
                        <GridViewColumn Header="Цена" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N0} ₽}" 
                                               FontWeight="Bold" 
                                               Foreground="#FF6B35"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Статус -->
                        <GridViewColumn Header="Статус" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FranStatusName}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Дата создания -->
                        <GridViewColumn Header="Дата" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yy}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Кнопки действий (появляются при выборе франшизы) -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" 
                HorizontalAlignment="Right" Margin="20">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnEdit" 
                        Content="✏️ Редактировать" 
                        Background="#3B82F6" Foreground="White"
                        BorderThickness="0" Padding="15,10"
                        Margin="0,0,10,0"
                        Cursor="Hand" Click="BtnEdit_Click"
                        IsEnabled="False">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnDelete" 
                        Content="🗑️ Удалить" 
                        Background="#EF4444" Foreground="White"
                        BorderThickness="0" Padding="15,10"
                        Cursor="Hand" Click="BtnDelete_Click"
                        IsEnabled="False">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>