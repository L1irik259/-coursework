<Window x:Class="FranchAdm.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему | FranchiseHub" 
        Height="480" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Стиль кнопки входа -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF6B35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E85D2A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" Margin="24">
        <StackPanel Margin="32" VerticalAlignment="Center">

            <!-- Логотип -->
            <TextBlock Text="🚀 FranchiseHub" 
                       FontSize="26" FontWeight="Bold" 
                       Foreground="#FF6B35" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,32"/>

            <!-- Email -->
            <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#2D3436"/>
            <TextBox x:Name="txtEmail" 
                     Height="40" Padding="12,0" 
                     BorderBrush="#DFE6E9" BorderThickness="1" 
                     FontSize="14"
                     MaxLength="150"
                     TextChanged="CheckInputs"
                     KeyDown="TxtEmail_KeyDown"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,16,0,6" Foreground="#2D3436"/>
            <PasswordBox x:Name="txtPassword" 
                         Height="40" Padding="12,0" 
                         BorderBrush="#DFE6E9" BorderThickness="1" 
                         FontSize="14"
                         MaxLength="150"
                         PasswordChanged="CheckInputs"
                         KeyDown="TxtPassword_KeyDown"/>

            <!-- Сообщение об ошибке -->
            <TextBlock x:Name="lblError" 
                       Foreground="#D63031" FontWeight="Medium" 
                       TextWrapping="Wrap" Margin="0,12,0,0" 
                       Visibility="Collapsed" 
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

            <!-- Кнопка входа -->
            <Button x:Name="btnLogin" 
                    Content="Войти" 
                    Height="44" Margin="0,24,0,0"
                    Style="{StaticResource LoginButtonStyle}"
                    Click="BtnLogin_Click"
                    IsEnabled="False"/>

            <!-- Статус -->
            <TextBlock x:Name="lblStatus" 
                       Text="Введите данные для входа" 
                       Foreground="#636E72" FontSize="12" 
                       HorizontalAlignment="Center" 
                       Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</Window>