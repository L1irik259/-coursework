<UserControl x:Class="FranchAdm.PriceHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📊 История изменения цен" 
                       FontSize="24" FontWeight="Bold"/>
        </DockPanel>

        <!-- Фильтры -->
        <Border Grid.Row="1" Background="White" 
                BorderBrush="#DFE6E9" BorderThickness="1" 
                CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск по франшизе -->
                <TextBox x:Name="txtSearch" 
                         Grid.Column="0"
                         Padding="10,8" 
                         BorderBrush="#DFE6E9" BorderThickness="1"
                         FontSize="14"
                         MaxLength="100"
                         TextChanged="TxtSearch_TextChanged"/>

                <!-- Фильтр по дате -->
                <DatePicker x:Name="dpFromDate" 
                            Grid.Column="1"
                            Padding="10,8"
                            FontSize="14"
                            Margin="10,0,10,0"
                            SelectedDateChanged="DateFilter_Changed"/>

                <!-- Кнопка сброса -->
                <Button Grid.Column="2" 
                        Content="🔄 Сброс" 
                        Background="#636E72" Foreground="White"
                        BorderThickness="0" Padding="10,8"
                        Cursor="Hand" Click="BtnReset_Click"/>
            </Grid>
        </Border>

        <!-- Список -->
        <Border Grid.Row="2" Background="White" 
                BorderBrush="#DFE6E9" BorderThickness="1" 
                CornerRadius="8">
            <ListView x:Name="lvHistory" 
                      BorderThickness="0" 
                      Background="Transparent"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <!-- ID -->
                        <GridViewColumn Header="ID" Width="60" DisplayMemberBinding="{Binding PriceHistoryId}"/>

                        <!-- Франшиза -->
                        <GridViewColumn Header="Франшиза" Width="250" DisplayMemberBinding="{Binding FranchiseName}"/>

                        <!-- Старая цена -->
                        <GridViewColumn Header="Старая цена" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OldPrice, StringFormat={}{0:N0} ₽}" 
                                               FontWeight="Bold" 
                                               Foreground="#EF4444"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Новая цена -->
                        <GridViewColumn Header="Новая цена" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NewPrice, StringFormat={}{0:N0} ₽}" 
                                               FontWeight="Bold" 
                                               Foreground="#10B981"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Изменение -->
                        <GridViewColumn Header="Изменение" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Difference, StringFormat={}{0:N0} ₽}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding DifferencePercent, StringFormat={}{0:N1}%}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Дата изменения -->
                        <GridViewColumn Header="Дата изменения" Width="150" DisplayMemberBinding="{Binding ChangedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>