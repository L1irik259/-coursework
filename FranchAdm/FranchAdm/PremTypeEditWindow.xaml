<Window x:Class="FranchAdm.PremTypeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тип помещения" 
        Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <!-- Название -->
            <TextBlock Text="Название *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtName" 
                     Padding="10,8" 
                     BorderBrush="#DFE6E9" BorderThickness="1"
                     FontSize="14"
                     MaxLength="100"
                     Margin="0,0,0,15"/>

            <!-- Минимальная площадь -->
            <TextBlock Text="Минимальная площадь (м²)" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtMinArea" 
                     Padding="10,8" 
                     BorderBrush="#DFE6E9" BorderThickness="1"
                     FontSize="14"
                     MaxLength="10"
                     PreviewTextInput="TxtMinArea_PreviewTextInput"
                     Margin="0,0,0,15"/>
            <TextBlock Text="Только целые положительные числа" 
                       Foreground="Gray" FontSize="11" Margin="0,-10,0,15"/>

            <!-- Требования -->
            <TextBlock Text="Требования" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtRequirements" 
                     Padding="10,8" 
                     BorderBrush="#DFE6E9" BorderThickness="1"
                     FontSize="14"
                     Height="100"
                     MaxLength="250"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="80" Padding="10,5"
                    Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button Content="💾 Сохранить" Width="100" Padding="10,5"
                    Background="#FF6B35" Foreground="White"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>