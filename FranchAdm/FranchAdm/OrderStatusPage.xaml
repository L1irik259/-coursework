<UserControl x:Class="FranchAdm.OrderStatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="btnAdd" 
                    DockPanel.Dock="Right"
                    Content="➕ Добавить" 
                    Background="#FF6B35" Foreground="White"
                    Padding="15,10" BorderThickness="0"
                    Cursor="Hand" Click="BtnAdd_Click"
                    Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock Text="📝 Статусы заказов" 
                       FontSize="24" FontWeight="Bold"/>
        </DockPanel>

        <!-- Поиск -->
        <Border Grid.Row="1" Background="White" 
                BorderBrush="#DFE6E9" BorderThickness="1" 
                CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" 
                         Grid.Column="0"
                         Padding="10,8" 
                         BorderBrush="#DFE6E9" BorderThickness="1"
                         FontSize="14"
                         MaxLength="50"
                         TextChanged="TxtSearch_TextChanged"/>

                <Button Grid.Column="1" 
                        Content="🔄 Сброс" 
                        Background="#636E72" Foreground="White"
                        BorderThickness="0" Padding="10,8"
                        Cursor="Hand" Click="BtnReset_Click"
                        Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Список -->
        <Border Grid.Row="2" Background="White" 
                BorderBrush="#DFE6E9" BorderThickness="1" 
                CornerRadius="8">
            <ListView x:Name="lvItems" 
                      BorderThickness="0" 
                      Background="Transparent"
                      SelectionMode="Single"
                      SelectionChanged="LvItems_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="60" DisplayMemberBinding="{Binding OrderStatusId}"/>
                        <GridViewColumn Header="Название" Width="400" DisplayMemberBinding="{Binding Name}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Кнопки -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" 
                HorizontalAlignment="Right" Margin="20">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnEdit" 
                        Content="✏️ Редактировать" 
                        Background="#3B82F6" Foreground="White"
                        BorderThickness="0" Padding="15,10"
                        Margin="0,0,10,0"
                        Cursor="Hand" Click="BtnEdit_Click"
                        IsEnabled="False"/>
                <Button x:Name="btnDelete" 
                        Content="🗑️ Удалить" 
                        Background="#EF4444" Foreground="White"
                        BorderThickness="0" Padding="15,10"
                        Cursor="Hand" Click="BtnDelete_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>