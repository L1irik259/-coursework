<UserControl x:Class="FranchAdm.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="btnAdd" 
                    DockPanel.Dock="Right"
                    Content="➕ Добавить пользователя" 
                    Background="#FF6B35" Foreground="White"
                    Padding="15,10" BorderThickness="0"
                    Cursor="Hand" Click="BtnAdd_Click"
                    Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock Text="👥 Управление пользователями" 
                       FontSize="24" FontWeight="Bold"/>
        </DockPanel>

        <!-- Фильтры -->
        <Border Grid.Row="1" Background="White" 
                BorderBrush="#DFE6E9" BorderThickness="1" 
                CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <TextBox x:Name="txtSearch" 
                         Grid.Column="0"
                         Padding="10,8" 
                         BorderBrush="#DFE6E9" BorderThickness="1"
                         FontSize="14"
                         MaxLength="100"
                         TextChanged="TxtSearch_TextChanged"/>

                <!-- Фильтр по роли -->
                <ComboBox x:Name="cmbRole" 
                          Grid.Column="1" 
                          Margin="10,0,10,0"
                          Padding="10,8"
                          FontSize="14"
                          SelectionChanged="CmbRole_SelectionChanged"/>

                <!-- Кнопка сброса -->
                <Button Grid.Column="2" 
                        Content="🔄 Сброс" 
                        Background="#636E72" Foreground="White"
                        BorderThickness="0" Padding="10,8"
                        Cursor="Hand" Click="BtnReset_Click"/>
            </Grid>
        </Border>

        <!-- Список -->
        <Border Grid.Row="2" Background="White" 
                BorderBrush="#DFE6E9" BorderThickness="1" 
                CornerRadius="8">
            <ListView x:Name="lvUsers" 
                      BorderThickness="0" 
                      Background="Transparent"
                      SelectionMode="Single"
                      SelectionChanged="LvUsers_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="60" DisplayMemberBinding="{Binding UserId}"/>
                        <GridViewColumn Header="ФИО" Width="200" DisplayMemberBinding="{Binding FullName}"/>
                        <GridViewColumn Header="Email" Width="200" DisplayMemberBinding="{Binding Email}"/>
                        <GridViewColumn Header="Телефон" Width="150" DisplayMemberBinding="{Binding Phone}"/>
                        <GridViewColumn Header="Роль" Width="120" DisplayMemberBinding="{Binding RoleName}"/>
                        <GridViewColumn Header="Статус" Width="100" DisplayMemberBinding="{Binding UserStatusName}"/>
                        <GridViewColumn Header="Дата регистрации" Width="150" DisplayMemberBinding="{Binding RegisteredAt, StringFormat={}{0:dd.MM.yyyy}}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Кнопки -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" 
                HorizontalAlignment="Right" Margin="20">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnEdit" 
                        Content="✏️ Редактировать" 
                        Background="#3B82F6" Foreground="White"
                        BorderThickness="0" Padding="15,10"
                        Margin="0,0,10,0"
                        Cursor="Hand" Click="BtnEdit_Click"
                        IsEnabled="False"/>
                <Button x:Name="btnDelete" 
                        Content="🗑️ Удалить" 
                        Background="#EF4444" Foreground="White"
                        BorderThickness="0" Padding="15,10"
                        Cursor="Hand" Click="BtnDelete_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>