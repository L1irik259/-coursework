<UserControl x:Class="FranchAdm.Views.OrderListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🛒 Управление заявками" 
                       FontSize="24" FontWeight="Bold" 
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Панель фильтров -->
        <Border Grid.Row="1" Background="White" 
                BorderBrush="#DFE6E9" BorderThickness="1" 
                CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск по клиенту -->
                <TextBox x:Name="txtSearch" 
                         Grid.Column="0"
                         Padding="10,8" 
                         BorderBrush="#DFE6E9" BorderThickness="1"
                         FontSize="14"
                         MaxLength="100"
                         TextChanged="TxtSearch_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Фильтр по статусу -->
                <ComboBox x:Name="cmbStatus" 
                          Grid.Column="1" 
                          Margin="10,0,10,0"
                          Padding="10,8"
                          FontSize="14"
                          SelectionChanged="CmbStatus_SelectionChanged">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <!-- Фильтр по франшизе -->
                <ComboBox x:Name="cmbFranchise" 
                          Grid.Column="2" 
                          Margin="0,0,10,0"
                          Padding="10,8"
                          FontSize="14"
                          SelectionChanged="CmbFranchise_SelectionChanged">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <!-- Кнопка сброса -->
                <Button Grid.Column="3" 
                        Content="🔄 Сброс" 
                        Background="#636E72" Foreground="White"
                        BorderThickness="0" Padding="10,8"
                        Cursor="Hand" Click="BtnReset_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ListView с заявками -->
        <Border Grid.Row="2" Background="White" 
                BorderBrush="#DFE6E9" BorderThickness="1" 
                CornerRadius="8">
            <ListView x:Name="lvOrders" 
                      BorderThickness="0" 
                      Background="Transparent"
                      SelectionMode="Single"
                      SelectionChanged="LvOrders_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <!-- Номер заявки -->
                        <GridViewColumn Header="№" Width="80" DisplayMemberBinding="{Binding OrderNumber}"/>

                        <!-- Клиент -->
                        <GridViewColumn Header="Клиент" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ClientEmail}" FontSize="11" Foreground="Gray"/>
                                        <TextBlock Text="{Binding ClientPhone}" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Франшиза -->
                        <GridViewColumn Header="Франшиза" Width="150" DisplayMemberBinding="{Binding FranchiseName}"/>

                        <!-- Статус -->
                        <GridViewColumn Header="Статус" Width="120" DisplayMemberBinding="{Binding StatusName}"/>

                        <!-- Сумма -->
                        <GridViewColumn Header="Сумма" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} ₽}" 
                                               FontWeight="Bold" Foreground="#FF6B35"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Дата -->
                        <GridViewColumn Header="Дата" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yy}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Регион -->
                        <GridViewColumn Header="Регион" Width="120" DisplayMemberBinding="{Binding RegionName}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Кнопки действий -->
        <Border Grid.Row="2" VerticalAlignment="Bottom"
                HorizontalAlignment="Right" Margin="20">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnEditStatus"
                        Content="✏️ Изменить статус"
                        Background="#3B82F6" Foreground="White"
                        BorderThickness="0" Padding="15,10"
                        Margin="0,0,10,0"
                        Cursor="Hand" Click="BtnEditStatus_Click"
                        IsEnabled="False">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnGenerateReceipt"
                        Content="📄 Сформировать чек"
                        Background="#10B981" Foreground="White"
                        BorderThickness="0" Padding="15,10"
                        Margin="0,0,10,0"
                        Cursor="Hand" Click="BtnGenerateReceipt_Click"
                        IsEnabled="False">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnDelete"
                        Content="🗑️ Удалить"
                        Background="#EF4444" Foreground="White"
                        BorderThickness="0" Padding="15,10"
                        Cursor="Hand" Click="BtnDelete_Click"
                        IsEnabled="False">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>