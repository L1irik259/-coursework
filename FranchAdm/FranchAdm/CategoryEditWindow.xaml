<Window x:Class="FranchAdm.CategoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Категория" 
        Height="250" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название -->
        <TextBlock Grid.Row="0" Text="Название *" 
                   FontWeight="SemiBold" Margin="0,0,0,5"/>

        <TextBox x:Name="txtName" 
                 Grid.Row="1"
                 Padding="10,8" 
                 BorderBrush="#DFE6E9" BorderThickness="1"
                 FontSize="14"
                 MaxLength="100"
                 PreviewTextInput="TxtName_PreviewTextInput"
                 Margin="0,0,0,20"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="80" Padding="10,5"
                    Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button Content="💾 Сохранить" Width="100" Padding="10,5"
                    Background="#FF6B35" Foreground="White"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>