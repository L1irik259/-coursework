<Window x:Class="FranchAdm.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" 
        Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,20">
                <!-- ФИО -->
                <TextBlock Text="ФИО *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFullName" 
                         Padding="10,8" 
                         BorderBrush="#DFE6E9" BorderThickness="1"
                         FontSize="14"
                         MaxLength="100"
                         Margin="0,0,0,15"/>

                <!-- Email -->
                <TextBlock Text="Email *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail" 
                         Padding="10,8" 
                         BorderBrush="#DFE6E9" BorderThickness="1"
                         FontSize="14"
                         MaxLength="100"
                         Margin="0,0,0,15"/>

                <!-- Телефон -->
                <TextBlock Text="Телефон" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtPhone" 
                         Padding="10,8" 
                         BorderBrush="#DFE6E9" BorderThickness="1"
                         FontSize="14"
                         MaxLength="50"
                         Margin="0,0,0,15"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" 
                             Padding="10,8" 
                             BorderBrush="#DFE6E9" BorderThickness="1"
                             FontSize="14"
                             MaxLength="100"
                             Margin="0,0,0,5"/>
                <TextBlock Text="Оставьте пустым чтобы не менять (при редактировании)" 
                           Foreground="Gray" FontSize="11" Margin="0,0,0,15"/>

                <!-- Роль -->
                <TextBlock Text="Роль *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbRole" 
                          Padding="10,8" 
                          FontSize="14"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="80" Padding="10,5"
                    Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button Content="💾 Сохранить" Width="100" Padding="10,5"
                    Background="#FF6B35" Foreground="White"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>