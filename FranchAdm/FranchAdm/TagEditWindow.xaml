<Window x:Class="FranchAdm.TagEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тег" 
        Height="350" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <!-- Название -->
            <TextBlock Text="Название *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtName" 
                     Padding="10,8" 
                     BorderBrush="#DFE6E9" BorderThickness="1"
                     FontSize="14"
                     MaxLength="50"
                     Margin="0,0,0,15"/>

            <!-- Цвет -->
            <TextBlock Text="Цвет тега" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Border x:Name="colorPreview" 
                        Width="40" Height="40" 
                        Background="#FF6B35" 
                        BorderBrush="Gray" 
                        BorderThickness="1" 
                        CornerRadius="5"
                        Margin="0,0,15,0"/>
                <StackPanel>
                    <ComboBox x:Name="cmbColor" 
                              Width="200"
                              Padding="10,8"
                              FontSize="14"
                              SelectionChanged="CmbColor_SelectionChanged">
                        <ComboBoxItem Content="Оранжевый" Tag="#FF6B35"/>
                        <ComboBoxItem Content="Синий" Tag="#3B82F6"/>
                        <ComboBoxItem Content="Зелёный" Tag="#10B981"/>
                        <ComboBoxItem Content="Красный" Tag="#EF4444"/>
                        <ComboBoxItem Content="Фиолетовый" Tag="#8B5CF6"/>
                        <ComboBoxItem Content="Жёлтый" Tag="#F59E0B"/>
                        <ComboBoxItem Content="Розовый" Tag="#EC4899"/>
                        <ComboBoxItem Content="Серый" Tag="#6B7280"/>
                    </ComboBox>
                    <TextBlock Text="Выберите цвет для тега" 
                               Foreground="Gray" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Произвольный цвет -->
            <TextBlock Text="Или введите свой цвет (HEX)" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtColor" 
                     Padding="10,8" 
                     BorderBrush="#DFE6E9" BorderThickness="1"
                     FontSize="14"
                     MaxLength="20"
                     TextChanged="TxtColor_TextChanged"
                     Margin="0,0,0,5"/>
            <TextBlock Text="Формат: #RRGGBB (например: #FF6B35)" 
                       Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="80" Padding="10,5"
                    Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button Content="💾 Сохранить" Width="100" Padding="10,5"
                    Background="#FF6B35" Foreground="White"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>