@model IEnumerable<FranchiseAggregator.Models.Review>
@{
    Layout = null;
    ViewData["Title"] = "Управление отзывами";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root { --primary: #ff6b35; --primary-dark: #e85d2a; --dark: #2d3436; --light: #fdfdfd; --gray: #636e72; --border: #dfe6e9; --sidebar-width: 280px; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--light); color: var(--dark); line-height: 1.6; }
        .sidebar { position: fixed; top: 0; left: 0; width: var(--sidebar-width); height: 100vh; background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; padding: 2rem 0; overflow-y: auto; z-index: 1000; }
        .sidebar-brand { font-size: 1.75rem; font-weight: 900; text-align: center; margin-bottom: 3rem; padding: 0 1.5rem; }
        .sidebar-brand i { color: #ffd23f; }
        .sidebar-menu { list-style: none; padding: 0 1rem; position: relative; left: -5px; }
        .sidebar-menu li { margin-bottom: 0.5rem; }
        .sidebar-menu a { display: flex; align-items: center; padding: 1rem 1.5rem; color: rgba(255,255,255,0.8); text-decoration: none; border-radius: 12px; transition: all 0.3s ease; font-weight: 600; }
        .sidebar-menu a:hover, .sidebar-menu a.active { background: rgba(255,255,255,0.2); color: white; transform: translateX(5px); }
        .sidebar-menu a i { margin-right: 1rem; font-size: 1.25rem; width: 24px; text-align: center; }
        .main-content { margin-left: var(--sidebar-width); min-height: 100vh; width: calc(100vw - var(--sidebar-width)); padding: 0; }
        .page-header { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); padding: 2rem 4rem; color: white; text-align: center; }
        .page-header h1 { font-size: 2.5rem; font-weight: 900; }
        .content-section { padding: 4rem; width: 100%; }
        .card-custom { background: white; border-radius: 20px; padding: 2rem; box-shadow: 0 8px 25px rgba(0,0,0,0.08); border: 1px solid var(--border); margin-bottom: 2rem; }
        .review-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
        .review-meta { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; color: var(--gray); font-size: 0.9rem; }
        .status-badge { padding: 0.4rem 1rem; border-radius: 50px; font-weight: 600; font-size: 0.85rem; }
        .status-new { background: #dbeafe; color: #1e40af; }
        .status-approved { background: #d1fae5; color: #065f46; }
        .status-rejected { background: #fee2e2; color: #991b1b; }
        .stars { color: #f59e0b; font-size: 1.2rem; letter-spacing: 2px; }
        .btn-action { padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.85rem; margin-right: 5px; border: none; cursor: pointer; }
        .btn-danger { background: #ef4444; color: white; }
        .alert { padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; }
        .alert-success { background: #d1fae5; border-left: 4px solid #10b981; color: #065f46; }
        .alert-danger { background: #fee2e2; border-left: 4px solid #ef4444; color: #991b1b; }
        .row { margin-left: 0 !important; margin-right: 0 !important; }
        .col, [class*="col-"] { padding-left: 15px !important; padding-right: 15px !important; }
    </style>
</head>
<body>
    <!-- Боковое меню -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-rocket-takeoff-fill"></i> FranchiseHub
        </div>
        
        <ul class="sidebar-menu">
            <li><a href="/"><i class="bi bi-house-door-fill"></i> Главная</a></li>
            <li><a href="/Catalog"><i class="bi bi-grid-fill"></i> Каталог франшиз</a></li>
            <li><a href="/Home/About"><i class="bi bi-info-circle"></i> О компании</a></li>
            <li><a href="/Home/Contacts"><i class="bi bi-envelope"></i> Контакты</a></li>
            <li><a href="/Home/News"><i class="bi bi-newspaper"></i> Новости</a></li>
            <li><a href="/Home/Promotions"><i class="bi bi-percent"></i> Акции</a></li>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="mt-4 mb-2 text-white-50 small text-uppercase fw-bold px-3">Личный кабинет</li>
                <li><a href="/Account/Profile"><i class="bi bi-person"></i> Мой профиль</a></li>
                <li><a href="/Order/Index"><i class="bi bi-card-heading"></i> Мои заявки</a></li>
                <li><a href="/Favorites/Index"><i class="bi bi-heart"></i> Избранное</a></li>
                
                @if (User.IsInRole("Менеджер") || User.IsInRole("Администратор сайта") || User.IsInRole("Администратор"))
                {
                    <li><a href="/Order/Management"><i class="bi bi-list-check"></i> Все заявки</a></li>
                }
                
                @if (User.IsInRole("Администратор сайта") || User.IsInRole("Администратор"))
                {
                    <li class="mt-4 mb-2 text-white-50 small text-uppercase fw-bold px-3">Администрирование</li>
                    <li><a href="/News/Index"><i class="bi bi-newspaper"></i> Управление новостями</a></li>
                    <li><a href="/Admin/Users"><i class="bi bi-people"></i> Управление пользователями</a></li>
                    <li><a href="/Admin/Feedbacks"><i class="bi bi-chat-dots"></i> Управление обратной связью</a></li>
                    <li><a href="/Reviews/Manage" class="active"><i class="bi bi-star"></i> Управление отзывами</a></li>
                }
                
                <li class="mt-4"><a href="/Account/Logout"><i class="bi bi-box-arrow-right"></i> Выход</a></li>
            }
            else
            {
                <li class="mt-4"><a href="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Войти</a></li>
                <li><a href="/Account/Register"><i class="bi bi-person-plus"></i> Регистрация</a></li>
            }
        </ul>
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar-user">
                <div class="sidebar-user-info">
                    <div class="sidebar-user-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div>
                        <div class="fw-bold">@User.Identity?.Name</div>
                        <small class="text-white-50">
                            @if (User.IsInRole("Администратор"))
                            {
                                <text>Администратор</text>
                            }
                            else if (User.IsInRole("Администратор сайта"))
                            {

                                <text>Администратор сайта</text>
                            }
                            else if (User.IsInRole("Менеджер"))
                            {

                                <text>Менеджер</text>
                            }
                            else
                            {

                                <text>Пользователь</text>
                            }
                        </small>
                    </div>
                </div>
            </div>
        }
    </aside>

    <div class="main-content">
        <div class="page-header">
            <h1>Управление отзывами</h1>
        </div>

        <section class="content-section">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["ErrorMessage"]</div>
            }

            @foreach (var review in Model)
            {
                <div class="card-custom">
                    <div class="review-header">
                        <div>
                            <h5 class="mb-1">
                                <i class="bi bi-person-fill me-2"></i>@(review.User?.FullName ?? "Пользователь удалён")
                                <span class="stars ms-2">
                                    @for(int i=0; i<review.Rating; i++) { <i class="bi bi-star-fill"></i> }
                                    @for(int i=review.Rating; i<5; i++) { <i class="bi bi-star"></i> }
                                </span>
                            </h5>
                            <div class="review-meta">
                                <span><i class="bi bi-building me-1"></i>@(review.Franchise?.Name ?? "Франшиза удалена")</span>
                                <span><i class="bi bi-calendar-fill me-1"></i>@review.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                        </div>
                        <span class="status-badge @(review.ModerStId == 1 ? "status-new" : review.ModerStId == 2 ? "status-approved" : "status-rejected")">
                            @review.ModerSt?.Name
                        </span>
                    </div>

                    <div class="mb-3">
                        <strong>Текст отзыва:</strong>
                        <p class="mt-2 mb-0" style="white-space: pre-wrap;">@review.Text</p>
                    </div>

                    <div class="mt-3">
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@review.ReviewId" />
                            <select name="moderStId" class="form-select form-select-sm" onchange="this.form.submit()" style="width: auto; display: inline-block;">
                                @foreach (var status in ViewBag.ModerStatuses as List<FranchiseAggregator.Models.ModerSt>)
                                {
                                    <option value="@status.ModerStId" selected="@(status.ModerStId == review.ModerStId)">
                                        @status.Name
                                    </option>
                                }
                            </select>
                        </form>

                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@review.ReviewId" />
                            <button type="submit" class="btn-action btn-danger" onclick="return confirm('Удалить этот отзыв навсегда?')">
                                <i class="bi bi-trash"></i> Удалить
                            </button>
                        </form>
                    </div>
                </div>
            }
        </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>