@using System.Collections.Generic
@{
    Layout = null;
    ViewData["Title"] = "О компании - FranchiseHub";
    
    var companyName = ViewBag.CompanyName ?? "FranchiseHub";
    var mission = ViewBag.Mission ?? "";
    var statsList = ViewBag.Stats as IEnumerable<Dictionary<string, string>>;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #ff6b35;
            --primary-dark: #e85d2a;
            --secondary: #f7c59f;
            --accent: #ffd23f;
            --dark: #2d3436;
            --light: #fdfdfd;
            --gray: #636e72;
            --border: #dfe6e9;
            --sidebar-width: 280px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; overflow-x: hidden; }
        body { font-family: 'Inter', sans-serif; background: var(--light); color: var(--dark); line-height: 1.6; }

        /* Sidebar Styles */
        .sidebar { 
            position: fixed; 
            top: 0; 
            left: 0; 
            width: var(--sidebar-width); 
            height: 100vh; 
            background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%); 
            color: white; 
            padding: 2rem 0; 
            overflow-y: auto; 
            z-index: 1000; 
            box-shadow: 4px 0 15px rgba(0,0,0,0.1); 
        }
        .sidebar-brand { 
            font-size: 1.75rem; 
            font-weight: 900; 
            text-align: center; 
            margin-bottom: 3rem; 
            padding: 0 1.5rem; 
        }
        .sidebar-brand i { color: var(--accent); }
        .sidebar-menu { list-style: none; padding: 0 1rem; }
        .sidebar-menu li { margin-bottom: 0.5rem; }
        .sidebar-menu a { 
            display: flex; 
            align-items: center; 
            padding: 1rem 1.5rem; 
            color: rgba(255,255,255,0.8); 
            text-decoration: none; 
            border-radius: 12px; 
            transition: all 0.3s ease; 
            font-weight: 600; 
        }
        .sidebar-menu a:hover, .sidebar-menu a.active { 
            background: rgba(255,255,255,0.2); 
            color: white; 
            transform: translateX(5px); 
        }
        .sidebar-menu a i { 
            margin-right: 1rem; 
            font-size: 1.25rem; 
            width: 24px; 
            text-align: center; 
        }
        
        .sidebar-user {
            margin-top: auto;
            padding: 1.5rem;
            border-top: 1px solid rgba(255, 255, 255, 0.2);
        }
        .sidebar-user-info {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
        }
        .sidebar-user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
            font-weight: bold;
            color: var(--primary);
        }

        /* Main Content */
        .main-content { 
            margin-left: var(--sidebar-width); 
            min-height: 100vh; 
            width: calc(100vw - var(--sidebar-width)); 
            padding: 0; 
            position: relative; 
        }
        
        /* Шапка страницы */
        .page-header-hero {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            padding: 3rem 4rem;
            text-align: center;
            color: white;
        }
        .page-header-hero h1 {
            font-size: 3rem;
            font-weight: 900;
            margin-bottom: 0.5rem;
        }
        .page-header-hero .subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* About Section */
        .about-section { padding: 4rem 4rem; width: 100%; }
        .card-custom { 
            background: white; 
            border-radius: 20px; 
            padding: 2.5rem; 
            box-shadow: 0 8px 25px rgba(0,0,0,0.08); 
            border: 1px solid var(--border); 
            margin-bottom: 2rem; 
        }
        
        .section-heading { font-size: 2rem; font-weight: 800; margin-bottom: 1.5rem; color: var(--dark); }
        .text-paragraph { font-size: 1.1rem; color: var(--gray); margin-bottom: 1rem; }

        /* Stats Grid */
        .stats-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
            gap: 2rem; 
            margin: 2rem 0; 
        }
        .stat-item { text-align: center; }
        .stat-number { 
            font-size: 3rem; 
            font-weight: 900; 
            color: var(--primary); 
            display: block; 
            line-height: 1; 
        }
        .stat-label { 
            font-size: 1rem; 
            color: var(--gray); 
            font-weight: 600; 
            text-transform: uppercase; 
            letter-spacing: 1px; 
        }

        /* CTA Section */
        .cta-section { 
            background: linear-gradient(135deg, #fff5f0, #ffeaa7); 
            border-radius: 20px; 
            padding: 3rem; 
            text-align: center; 
            border: 1px solid var(--accent); 
        }
        .btn-submit-lg { 
            background: var(--primary); 
            color: white; 
            padding: 1rem 3rem; 
            border-radius: 15px; 
            font-size: 1.2rem; 
            font-weight: 700; 
            border: none; 
            cursor: pointer; 
            transition: all 0.3s ease; 
            display: inline-block; 
            text-decoration: none;
        }
        .btn-submit-lg:hover { 
            background: var(--primary-dark); 
            transform: translateY(-2px); 
            box-shadow: 0 10px 25px rgba(255,107,53,0.4); 
        }

        .row { margin-left: 0 !important; margin-right: 0 !important; }
        .col, [class*="col-"] { padding-left: 15px !important; padding-right: 15px !important; }
    </style>
</head>
<body>
    <!-- Боковое меню -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-rocket-takeoff-fill"></i> FranchiseHub
        </div>
        
        <ul class="sidebar-menu">
            <li><a href="/"><i class="bi bi-house-door-fill"></i> Главная</a></li>
            <li><a href="/Catalog"><i class="bi bi-grid-fill"></i> Каталог франшиз</a></li>
            <li><a href="/Home/About" class="active"><i class="bi bi-info-circle"></i> О компании</a></li>
            <li><a href="/Home/Contacts"><i class="bi bi-envelope"></i> Контакты</a></li>
            <li><a href="/Home/News"><i class="bi bi-newspaper"></i> Новости</a></li>
            <li><a href="/Home/Promotions"><i class="bi bi-percent"></i> Акции</a></li>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="mt-4 mb-2 text-white-50 small text-uppercase fw-bold px-3">Личный кабинет</li>
                <li><a href="/Account/Profile"><i class="bi bi-person"></i> Мой профиль</a></li>
                <li><a href="/Order/Index"><i class="bi bi-card-heading"></i> Мои заявки</a></li>
                <li><a href="/Favorites/Index"><i class="bi bi-heart"></i> Избранное</a></li>
                
                @if (User.IsInRole("Менеджер") || User.IsInRole("Администратор сайта") || User.IsInRole("Администратор"))
                {
                    <li><a href="/Order/Management"><i class="bi bi-list-check"></i> Все заявки</a></li>
                }
                
                @if (User.IsInRole("Администратор сайта") || User.IsInRole("Администратор"))
                {
                    <li class="mt-4 mb-2 text-white-50 small text-uppercase fw-bold px-3">Администрирование</li>
                    <li><a href="/News/Index"><i class="bi bi-newspaper"></i> Управление новостями</a></li>
                    <li><a href="/Admin/Users"><i class="bi bi-people"></i> Управление пользователями</a></li>
                    <li><a href="/Admin/Feedbacks"><i class="bi bi-chat-dots"></i> Управление обратной связью</a></li>
                    <li><a href="/Reviews/Manage"><i class="bi bi-star"></i> Управление отзывами</a></li>
                }
                
                <li class="mt-4"><a href="/Account/Logout"><i class="bi bi-box-arrow-right"></i> Выход</a></li>
            }
            else
            {
                <li class="mt-4"><a href="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Войти</a></li>
                <li><a href="/Account/Register"><i class="bi bi-person-plus"></i> Регистрация</a></li>
            }
        </ul>
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar-user">
                <div class="sidebar-user-info">
                    <div class="sidebar-user-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div>
                        <div class="fw-bold">@User.Identity?.Name</div>
                        <small class="text-white-50">
                            @if (User.IsInRole("Администратор")) { <text>Администратор</text> }
                            else if (User.IsInRole("Администратор сайта")) { <text>Администратор сайта</text> }
                            else if (User.IsInRole("Менеджер")) { <text>Менеджер</text> }
                            else { <text>Пользователь</text> }
                        </small>
                    </div>
                </div>
            </div>
        }
    </aside>

    <div class="main-content">
        <!-- Шапка -->
        <div class="page-header-hero">
            <h1>О компании</h1>
            <div class="subtitle">Мы делаем предпринимательство доступным и прозрачным</div>
        </div>

        <section class="about-section container-fluid">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-md-12">
                    
                    <!-- Intro Card -->
                    <div class="card-custom">
                        <h2 class="section-heading">Кто мы такие?</h2>
                        <p class="text-paragraph">
                            Мы — команда профессионалов, увлеченных идеей сделать предпринимательство доступным и прозрачным.
                            FranchiseHub — это современная платформа для поиска и открытия бизнеса по франшизе.
                        </p>
                        <p class="text-paragraph">
                            Наша миссия: <strong>@mission</strong>
                        </p>
                    </div>

                    <!-- Stats Card -->
                    <div class="card-custom">
                        <h2 class="section-heading">Наша статистика</h2>
                        
                        @if (statsList != null)
                        {
                            <div class="stats-grid">
                                @foreach (var stat in statsList)
                                {
                                    <div class="stat-item">
                                        <span class="stat-number">@stat["count"]</span>
                                        <span class="stat-label">@stat["label"]</span>
                                    </div>
                                }
                            </div>
                        }
                        else 
                        {
                            <p>Загрузка данных...</p>
                        }
                    </div>

                    <!-- Values/Cards Row -->
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="card-custom h-100">
                                <div class="mb-3 text-primary"><i class="bi bi-shield-check" style="font-size: 2rem;"></i></div>
                                <h3 class="section-heading" style="font-size: 1.5rem;">Надежность</h3>
                                <p class="text-paragraph">Каждая франшиза проходит строгую проверку перед размещением в нашем каталоге.</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card-custom h-100">
                                <div class="mb-3 text-success"><i class="bi bi-graph-up" style="font-size: 2rem;"></i></div>
                                <h3 class="section-heading" style="font-size: 1.5rem;">Рост</h3>
                                <p class="text-paragraph">Мы поддерживаем наших клиентов на каждом этапе старта бизнеса, от идеи до первых продаж.</p>
                            </div>
                        </div>
                    </div>

                    <!-- CTA Section -->
                    <div class="cta-section mt-4">
                        <h2 class="section-heading" style="color: var(--primary-dark);">Готовы начать свой бизнес?</h2>
                        <p class="text-paragraph">Выберите идеальную франшизу прямо сейчас и начните путь к свободе.</p>
                        <a href="/Catalog" class="btn-submit-lg">Перейти в каталог</a>
                    </div>
                    
                </div>
            </div>
        </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>