@model FranchiseAgregator.Models.Feedback
@{
    Layout = null;
    ViewData["Title"] = "Контакты - FranchiseHub";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        :root { --primary: #ff6b35; --primary-dark: #e85d2a; --secondary: #f7c59f; --accent: #ffd23f; --dark: #2d3436; --light: #fdfdfd; --gray: #636e72; --border: #dfe6e9; --sidebar-width: 280px; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; overflow-x: hidden; }
        body { font-family: 'Inter', sans-serif; background: var(--light); color: var(--dark); line-height: 1.6; }

        .sidebar { position: fixed; top: 0; left: 0; width: var(--sidebar-width); height: 100vh; background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; padding: 2rem 0; overflow-y: auto; z-index: 1000; box-shadow: 4px 0 15px rgba(0,0,0,0.1); }
        .sidebar-brand { font-size: 1.75rem; font-weight: 900; text-align: center; margin-bottom: 3rem; padding: 0 1.5rem; }
        .sidebar-brand i { color: var(--accent); }
        .sidebar-menu { list-style: none; padding: 0 1rem; position: relative; left: -5px; }
        .sidebar-menu li { margin-bottom: 0.5rem; }
        .sidebar-menu a { display: flex; align-items: center; padding: 1rem 1.5rem; color: rgba(255,255,255,0.8); text-decoration: none; border-radius: 12px; transition: all 0.3s ease; font-weight: 600; }
        .sidebar-menu a:hover, .sidebar-menu a.active { background: rgba(255,255,255,0.2); color: white; transform: translateX(5px); }
        .sidebar-menu a i { margin-right: 1rem; font-size: 1.25rem; width: 24px; text-align: center; }
        
        .main-content { margin-left: var(--sidebar-width); min-height: 100vh; width: calc(100vw - var(--sidebar-width)); padding: 0; position: relative; }
        
        .page-header-hero { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); padding: 3rem 4rem; text-align: center; color: white; }
        .page-header-hero h1 { font-size: 3rem; font-weight: 900; margin-bottom: 0.5rem; }
        .page-header-hero .subtitle { font-size: 1.2rem; opacity: 0.9; }

        .about-section { padding: 4rem 4rem; width: 100%; }
        .card-custom { background: white; border-radius: 20px; padding: 2.5rem; box-shadow: 0 8px 25px rgba(0,0,0,0.08); border: 1px solid var(--border); margin-bottom: 2rem; }
        .section-heading { font-size: 2rem; font-weight: 800; margin-bottom: 1.5rem; color: var(--dark); }
        .text-paragraph { font-size: 1.1rem; color: var(--gray); margin-bottom: 1rem; }

        .contact-info-card { display: flex; gap: 1.5rem; margin-bottom: 1.5rem; align-items: center; }
        .contact-icon-wrapper { width: 60px; height: 60px; background: rgba(255,107,53,0.1); border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: var(--primary); flex-shrink: 0; }
        .contact-text p { margin: 0; color: var(--gray); }

        .map-container { width: 100%; height: 400px; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }

        .row { margin-left: 0 !important; margin-right: 0 !important; }
        .col, [class*="col-"] { padding-left: 15px !important; padding-right: 15px !important; }

        .validation-message { color: var(--primary-dark); font-size: 0.875rem; margin-top: 0.25rem; display: block; }
        
        .btn-submit-lg { 
            background-color: var(--primary) !important; 
            color: white !important; 
            font-weight: 700; 
            transition: all 0.3s ease; 
            border: none;
        }
        .btn-submit-lg:hover { 
            background-color: var(--primary-dark) !important; 
            transform: translateY(-2px); 
            box-shadow: 0 10px 25px rgba(255,107,53,0.4);
        }

        .sidebar-user { margin-top: auto; padding: 1.5rem; border-top: 1px solid rgba(255,255,255,0.2); }
        .sidebar-user-info { display: flex; align-items: center; margin-bottom: 1rem; }
        .sidebar-user-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; margin-right: 1rem; font-weight: bold; color: var(--primary); }
    </style>
</head>
<body>
   <!-- Боковое меню -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-rocket-takeoff-fill"></i> FranchiseHub
        </div>
        
        <ul class="sidebar-menu">
            <li><a href="/"><i class="bi bi-house-door-fill"></i> Главная</a></li>
            <li><a href="/Catalog"><i class="bi bi-grid-fill"></i> Каталог франшиз</a></li>
            <li><a href="/Home/About"><i class="bi bi-info-circle"></i> О компании</a></li>
            <li><a href="/Home/Contacts" class="active"><i class="bi bi-envelope"></i> Контакты</a></li>
            <li><a href="/Home/News"><i class="bi bi-newspaper"></i> Новости</a></li>
            <li><a href="/Home/Promotions"><i class="bi bi-percent"></i> Акции</a></li>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="mt-4 mb-2 text-white-50 small text-uppercase fw-bold px-3">Личный кабинет</li>
                <li><a href="/Account/Profile"><i class="bi bi-person"></i> Мой профиль</a></li>
                <li><a href="/Order/Index"><i class="bi bi-card-heading"></i> Мои заявки</a></li>
                <li><a href="/Favorites/Index"><i class="bi bi-heart"></i> Избранное</a></li>
                
                @if (User.IsInRole("Менеджер") || User.IsInRole("Администратор сайта") || User.IsInRole("Администратор"))
                {
                    <li><a href="/Order/Management"><i class="bi bi-list-check"></i> Все заявки</a></li>
                }
                
                @if (User.IsInRole("Администратор сайта") || User.IsInRole("Администратор"))
                {
                    <li class="mt-4 mb-2 text-white-50 small text-uppercase fw-bold px-3">Администрирование</li>
                    <li><a href="/News/Index"><i class="bi bi-newspaper"></i> Управление новостями</a></li>
                    <li><a href="/Admin/Users"><i class="bi bi-people"></i> Управление пользователями</a></li>
                    <li><a href="/Admin/Feedbacks"><i class="bi bi-chat-dots"></i> Управление обратной связью</a></li>
                    <li><a href="/Reviews/Manage"><i class="bi bi-star"></i> Управление отзывами</a></li>
                }
                
                <li class="mt-4"><a href="/Account/Logout"><i class="bi bi-box-arrow-right"></i> Выход</a></li>
            }
            else
            {
                <li class="mt-4"><a href="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Войти</a></li>
                <li><a href="/Account/Register"><i class="bi bi-person-plus"></i> Регистрация</a></li>
            }
        </ul>
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar-user">
                <div class="sidebar-user-info">
                    <div class="sidebar-user-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div>
                        <div class="fw-bold">@User.Identity?.Name</div>
                        <small class="text-white-50">
                            @if (User.IsInRole("Администратор")) { <text>Администратор</text> }
                            else if (User.IsInRole("Администратор сайта")) { <text>Администратор сайта</text> }
                            else if (User.IsInRole("Менеджер")) { <text>Менеджер</text> }
                            else { <text>Пользователь</text> }
                        </small>
                    </div>
                </div>
            </div>
        }
    </aside>

    <div class="main-content">
        <div class="page-header-hero">
            <h1>Контакты</h1>
            <div class="subtitle">Мы всегда на связи и готовы ответить на ваши вопросы</div>
        </div>

        <section class="about-section container-fluid">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-md-12">
                    
                    <div class="row g-4">
                        <!-- Левая колонка: Информация -->
                        <div class="col-lg-5 mb-4">
                            <div class="card-custom h-100">
                                <h2 class="section-heading">Наша команда</h2>
                                
                                <div class="mb-4">
                                    <h5 class="fw-bold text-primary mb-3">Головной офис</h5>
                                    <div class="contact-info-card">
                                        <div class="contact-icon-wrapper"><i class="bi bi-geo-alt-fill"></i></div>
                                        <div class="contact-text">
                                            <p>Москва, ул. Примерная, д. 123</p>
                                        </div>
                                    </div>
                                    <div class="contact-info-card">
                                        <div class="contact-icon-wrapper"><i class="bi bi-telephone-fill"></i></div>
                                        <div class="contact-text">
                                            <p>+7 (495) 123-45-67</p>
                                            <small>ежедневно 9:00 - 18:00</small>
                                        </div>
                                    </div>
                                    <div class="contact-info-card">
                                        <div class="contact-icon-wrapper"><i class="bi bi-envelope-fill"></i></div>
                                        <div class="contact-text">
                                            <p>info@franchisehub.ru</p>
                                        </div>
                                    </div>
                                </div>

                                <h5 class="fw-bold text-primary mb-3">Как нас найти</h5>
                                <div class="map-container">
                                    <iframe src="https://yandex.ru/map-widget/v1/?ll=37.620393%2C55.753931&z=13&pt=37.620393%2C55.753931,pm2rdm" width="100%" height="300" frameborder="0" allowfullscreen="true" style="border:0;"></iframe>
                                </div>
                            </div>
                        </div>

                        <!-- Правая колонка: Форма -->
                        <div class="col-lg-7 mb-4">
                            <div class="card-custom h-100">
                                <h2 class="section-heading">Напишите нам</h2>
                                <p class="text-paragraph mb-4">Оставьте заявку, и наш менеджер свяжется с вами в течение часа.</p>
                                
                                @if (TempData["SuccessMessage"] != null)
                                {
                                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                                        <strong><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</strong>
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                    </div>
                                }

                                @if (TempData["ErrorMessage"] != null)
                                {
                                    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                                        <strong><i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["ErrorMessage"]</strong>
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                    </div>
                                }

                                <form asp-controller="Home" asp-action="SendFeedback" method="post">
                                    @Html.AntiForgeryToken()
                                    
                                    <!-- 🔹 СКРЫТОЕ ПОЛЕ: Статус по умолчанию = "Новое" (ID=1) -->
                                    <input type="hidden" name="FeedbackStatusId" value="1" />
                                    
                                    <div class="row g-3">
                                        <!-- Имя -->
                                        <div class="col-md-6">
                                            <label asp-for="Name" class="form-label fw-bold small">Ваше имя</label>
                                            <input asp-for="Name" class="form-control rounded-3 py-3" placeholder="Иван Иванов" required maxlength="100" />
                                            <span asp-validation-for="Name" class="validation-message"></span>
                                        </div>
                                        
                                        <!-- Телефон -->
                                        <div class="col-md-6">
                                            <label asp-for="Phone" class="form-label fw-bold small">Телефон</label>
                                            <input asp-for="Phone" class="form-control rounded-3 py-3" placeholder="+7 (999) 000-00-00" required />
                                            <span asp-validation-for="Phone" class="validation-message"></span>
                                        </div>
                                        
                                        <!-- Email -->
                                        <div class="col-12">
                                            <label asp-for="Email" class="form-label fw-bold small">Email</label>
                                            <input asp-for="Email" class="form-control rounded-3 py-3" placeholder="example@mail.ru" />
                                            <span asp-validation-for="Email" class="validation-message"></span>
                                        </div>
                                        
                                        <!-- Сообщение -->
                                        <div class="col-12">
                                            <label asp-for="Message" class="form-label fw-bold small">Сообщение</label>
                                            <textarea asp-for="Message" class="form-control rounded-3 py-3" rows="4" placeholder="Ваш вопрос..." required minlength="10"></textarea>
                                            <span asp-validation-for="Message" class="validation-message"></span>
                                        </div>
                                        
                                        <!-- Кнопка отправки -->
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-submit-lg w-100 py-3">
                                                Отправить сообщение <i class="bi bi-paper-plane-fill ms-2"></i>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>