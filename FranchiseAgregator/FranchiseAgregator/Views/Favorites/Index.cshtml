@model IEnumerable<FranchiseAggregator.Models.Favorite>
@{
    Layout = null;
    ViewData["Title"] = "Избранное";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        :root { --primary: #ff6b35; --primary-dark: #e85d2a; --secondary: #f7c59f; --accent: #ffd23f; --dark: #2d3436; --light: #fdfdfd; --gray: #636e72; --border: #dfe6e9; --sidebar-width: 280px; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; overflow-x: hidden; }
        body { font-family: 'Inter', sans-serif; background: var(--light); color: var(--dark); line-height: 1.6; }

        /* Сайдбар */
        .sidebar { position: fixed; top: 0; left: 0; width: var(--sidebar-width); height: 100vh; background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; padding: 2rem 0; overflow-y: auto; z-index: 1000; box-shadow: 4px 0 15px rgba(0,0,0,0.1); }
        .sidebar-brand { font-size: 1.75rem; font-weight: 900; text-align: center; margin-bottom: 3rem; padding: 0 1.5rem; }
        .sidebar-brand i { color: var(--accent); }
        .sidebar-menu { list-style: none; padding: 0 1rem; position: relative; left: -5px; }
        .sidebar-menu li { margin-bottom: 0.5rem; }
        .sidebar-menu a { display: flex; align-items: center; padding: 1rem 1.5rem; color: rgba(255,255,255,0.8); text-decoration: none; border-radius: 12px; transition: all 0.3s ease; font-weight: 600; }
        .sidebar-menu a:hover, .sidebar-menu a.active { background: rgba(255,255,255,0.2); color: white; transform: translateX(5px); }
        .sidebar-menu a i { margin-right: 1rem; font-size: 1.25rem; width: 24px; text-align: center; }
        
        .main-content { margin-left: var(--sidebar-width); min-height: 100vh; width: calc(100vw - var(--sidebar-width)); padding: 0; position: relative; }
        .page-header-hero { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); padding: 3rem 4rem; text-align: center; color: white; }
        .page-header-hero h1 { font-size: 3rem; font-weight: 900; margin-bottom: 0.5rem; }
        .page-header-hero .subtitle { font-size: 1.2rem; opacity: 0.9; }

        .favorites-section { padding: 4rem 4rem; width: 100%; }
        .section-heading { font-size: 2rem; font-weight: 800; margin-bottom: 2rem; color: var(--dark); }
        
        /* Карточка избранного */
        .fav-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border: 1px solid var(--border);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            transition: all 0.3s ease;
        }
        .fav-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }
        
        .fav-img {
            width: 120px;
            height: 120px;
            border-radius: 12px;
            object-fit: cover;
            margin-right: 1.5rem;
            flex-shrink: 0;
        }
        
        .fav-info { flex-grow: 1; }
        .fav-title { font-size: 1.4rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--dark); }
        .fav-meta { font-size: 0.9rem; color: var(--gray); margin-bottom: 0.5rem; }
        .fav-price { font-size: 1.2rem; font-weight: 700; color: var(--primary); margin-bottom: 1rem; }
        
        .btn-view { 
            background: var(--primary); 
            color: white; 
            border: none; 
            padding: 0.5rem 1.5rem; 
            border-radius: 10px; 
            font-weight: 600; 
            text-decoration: none; 
            display: inline-block;
            transition: all 0.3s;
        }
        .btn-view:hover { background: var(--primary-dark); color: white; text-decoration: none; }
        
        .btn-remove { 
            background: transparent; 
            color: #dc3545; 
            border: 2px solid #dc3545; 
            padding: 0.5rem 1rem; 
            border-radius: 10px; 
            font-weight: 600; 
            cursor: pointer; 
            transition: all 0.3s;
            margin-left: 1rem;
        }
        .btn-remove:hover { background: #dc3545; color: white; }

        .sidebar-user { margin-top: auto; padding: 1.5rem; border-top: 1px solid rgba(255,255,255,0.2); }
        .sidebar-user-info { display: flex; align-items: center; margin-bottom: 1rem; }
        .sidebar-user-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; margin-right: 1rem; font-weight: bold; color: var(--primary); }
        
        .row { margin-left: 0 !important; margin-right: 0 !important; }
        .col, [class*="col-"] { padding-left: 15px !important; padding-right: 15px !important; }
    </style>
</head>
<body>
    <!-- Боковое меню -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-rocket-takeoff-fill"></i> FranchiseHub
        </div>
        
        <ul class="sidebar-menu">
            <li><a href="/"><i class="bi bi-house-door-fill"></i> Главная</a></li>
            <li><a href="/Catalog"><i class="bi bi-grid-fill"></i> Каталог франшиз</a></li>
            <li><a href="/Home/About"><i class="bi bi-info-circle"></i> О компании</a></li>
            <li><a href="/Home/Contacts"><i class="bi bi-envelope"></i> Контакты</a></li>
            <li><a href="/Home/News"><i class="bi bi-newspaper"></i> Новости</a></li>
            <li><a href="/Home/Promotions"><i class="bi bi-percent"></i> Акции</a></li>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="mt-4 mb-2 text-white-50 small text-uppercase fw-bold px-3">Личный кабинет</li>
                <li><a href="/Account/Profile"><i class="bi bi-person"></i> Мой профиль</a></li>
                <li><a href="/Order/Index"><i class="bi bi-card-heading"></i> Мои заявки</a></li>
                <li><a href="/Favorites/Index" class="active"><i class="bi bi-heart"></i> Избранное</a></li>
                
                @if (User.IsInRole("Менеджер") || User.IsInRole("Администратор сайта") || User.IsInRole("Администратор"))
                {
                    <li><a href="/Order/Management"><i class="bi bi-list-check"></i> Все заявки</a></li>
                }
                
                @if (User.IsInRole("Администратор сайта") || User.IsInRole("Администратор"))
                {
                    <li class="mt-4 mb-2 text-white-50 small text-uppercase fw-bold px-3">Администрирование</li>
                    <li><a href="/News/Index"><i class="bi bi-newspaper"></i> Управление новостями</a></li>
                    <li><a href="/Admin/Users"><i class="bi bi-people"></i> Управление пользователями</a></li>
                    <li><a href="/Admin/Feedbacks"><i class="bi bi-chat-dots"></i> Управление обратной связью</a></li>
                    <li><a href="/Reviews/Manage"><i class="bi bi-star"></i> Управление отзывами</a></li>
                }
                
                <li class="mt-4"><a href="/Account/Logout"><i class="bi bi-box-arrow-right"></i> Выход</a></li>
            }
            else
            {
                <li class="mt-4"><a href="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Войти</a></li>
                <li><a href="/Account/Register"><i class="bi bi-person-plus"></i> Регистрация</a></li>
            }
        </ul>
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar-user">
                <div class="sidebar-user-info">
                    <div class="sidebar-user-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div>
                        <div class="fw-bold">@User.Identity?.Name</div>
                        <small class="text-white-50">
                            @if (User.IsInRole("Администратор")) { <text>Администратор</text> }
                            else if (User.IsInRole("Администратор сайта")) { <text>Администратор сайта</text> }
                            else if (User.IsInRole("Менеджер")) { <text>Менеджер</text> }
                            else { <text>Пользователь</text> }
                        </small>
                    </div>
                </div>
            </div>
        }
    </aside>

    <div class="main-content">
        <div class="page-header-hero">
            <h1>Избранное</h1>
            <div class="subtitle">Сохранённые франшизы для быстрого доступа</div>
        </div>

        <section class="favorites-section container-fluid">
            <h2 class="section-heading">Ваши сохранения</h2>

            @if (Model != null && Model.Any())
            {
                <div class="row">
                    @foreach (var item in Model)
                    {
                        <div class="col-12">
                            @if (item.Franchise != null)
                            {
                                <div class="fav-card">
                                    <!-- Картинка франшизы -->
                                    @if (!string.IsNullOrEmpty(item.Franchise.MinPhotoUrl))
                                    {
                                        <img src="@item.Franchise.MinPhotoUrl" alt="@item.Franchise.Name" class="fav-img">
                                    }
                                    else
                                    {
                                        <img src="https://placehold.co/120x120/f7c59f/ff6b35?text=No+Image" alt="Нет фото" class="fav-img">
                                    }
                                    
                                    <!-- Информация -->
                                    <div class="fav-info">
                                        <h3 class="fav-title">@item.Franchise.Name</h3>
                                        <div class="fav-meta">
                                            <i class="bi bi-tag me-1"></i> @item.Franchise.Category?.Name 
                                            <span class="mx-2">•</span> 
                                            <i class="bi bi-building me-1"></i> @item.Franchise.Franchiser?.Name
                                        </div>
                                        <div class="fav-price">
                                            Паушальный взнос: @String.Format("{0:N0}", item.Franchise.PledgeAmount) ₽
                                        </div>
                                        
                                        <div class="d-flex align-items-center">
                                            <a href="/Franchise/Index/@item.Franchise.FranchiseId" class="btn-view">
                                                Перейти к франшизе <i class="bi bi-arrow-right ms-1"></i>
                                            </a>
                                            
                                            <!-- Форма удаления -->
                                            <form asp-controller="Favorites" asp-action="Remove" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.FavoriteId" />
                                                <button type="submit" class="btn-remove" onclick="return confirm('Удалить эту франшизу из избранного?');">
                                                    <i class="bi bi-trash me-1"></i> Удалить
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 card-custom">
                    <i class="bi bi-heart display-1 text-muted mb-3" style="color: var(--secondary);"></i>
                    <h4 class="fw-bold text-muted">Список избранного пуст</h4>
                    <p class="text-muted mb-4">Вы пока не добавили ни одной франшизы в избранное.</p>
                    <a href="/Catalog" class="btn-view" style="padding: 1rem 2rem; font-size: 1.1rem;">
                        Перейти в каталог <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            }
        </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>