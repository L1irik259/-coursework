@model IEnumerable<FranchiseAggregator.Models.Order>
@{
    Layout = null;
    ViewData["Title"] = "Мои заявки";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        :root { --primary: #ff6b35; --primary-dark: #e85d2a; --secondary: #f7c59f; --accent: #ffd23f; --dark: #2d3436; --light: #fdfdfd; --gray: #636e72; --border: #dfe6e9; --sidebar-width: 280px; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; overflow-x: hidden; }
        body { font-family: 'Inter', sans-serif; background: var(--light); color: var(--dark); line-height: 1.6; }

        /* Стили бокового меню */
        .sidebar { position: fixed; top: 0; left: 0; width: var(--sidebar-width); height: 100vh; background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; padding: 2rem 0; overflow-y: auto; z-index: 1000; box-shadow: 4px 0 15px rgba(0,0,0,0.1); }
        .sidebar-brand { font-size: 1.75rem; font-weight: 900; text-align: center; margin-bottom: 3rem; padding: 0 1.5rem; }
        .sidebar-brand i { color: var(--accent); }
        .sidebar-menu { list-style: none; padding: 0 1rem; position: relative; left: -5px; }
        .sidebar-menu li { margin-bottom: 0.5rem; }
        .sidebar-menu a { display: flex; align-items: center; padding: 1rem 1.5rem; color: rgba(255,255,255,0.8); text-decoration: none; border-radius: 12px; transition: all 0.3s ease; font-weight: 600; }
        .sidebar-menu a:hover, .sidebar-menu a.active { background: rgba(255,255,255,0.2); color: white; transform: translateX(5px); }
        .sidebar-menu a i { margin-right: 1rem; font-size: 1.25rem; width: 24px; text-align: center; }
        
        .main-content { margin-left: var(--sidebar-width); min-height: 100vh; width: calc(100vw - var(--sidebar-width)); padding: 0; position: relative; }
        .page-header-hero { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); padding: 3rem 4rem; text-align: center; color: white; }
        .page-header-hero h1 { font-size: 3rem; font-weight: 900; margin-bottom: 0.5rem; }
        .page-header-hero .subtitle { font-size: 1.2rem; opacity: 0.9; }

        .orders-section { padding: 4rem 4rem; width: 100%; }
        .card-custom { background: white; border-radius: 20px; padding: 2.5rem; box-shadow: 0 8px 25px rgba(0,0,0,0.08); border: 1px solid var(--border); margin-bottom: 2rem; }
        .section-heading { font-size: 2rem; font-weight: 800; margin-bottom: 2rem; color: var(--dark); }
        
        /* Стили таблицы заявок */
        .orders-table { width: 100%; border-collapse: separate; border-spacing: 0 15px; }
        .orders-table th { color: var(--gray); font-weight: 600; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1px; padding: 10px 15px; text-align: left; }
        .orders-table td { background: white; padding: 20px 15px; border: none; vertical-align: middle; }
        
        /* Скругление краев строк таблицы */
        .orders-table tr td:first-child { border-radius: 15px 0 0 15px; border-left: 1px solid var(--border); }
        .orders-table tr td:last-child { border-radius: 0 15px 15px 0; border-right: 1px solid var(--border); }
        .orders-table td { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
        
        /* Цвета статусов */
        .status-badge { padding: 6px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; display: inline-block; }
        .status-new { background: #e3f2fd; color: #1565c0; } /* Синий */
        .status-pending { background: #fff3e0; color: #ef6c00; } /* Оранжевый */
        .status-approved { background: #e8f5e9; color: #2e7d32; } /* Зеленый */
        .status-rejected { background: #ffebee; color: #c62828; } /* Красный */
        
        /* Кнопка */
        .btn-details { 
            background: transparent; 
            border: 2px solid var(--primary); 
            color: var(--primary); 
            padding: 0.5rem 1.25rem; 
            border-radius: 10px; 
            font-weight: 600; 
            text-decoration: none;
            transition: all 0.3s;
            display: inline-block;
        }
        .btn-details:hover { background: var(--primary); color: white; text-decoration: none; }
        
        /* Кнопка в каталог */
        .btn-save { background: var(--primary); color: white; border: none; padding: 0.75rem 2rem; border-radius: 15px; font-weight: 700; transition: all 0.3s; text-decoration: none; }
        .btn-save:hover { background: var(--primary-dark); color: white; text-decoration: none; }

        .sidebar-user { margin-top: auto; padding: 1.5rem; border-top: 1px solid rgba(255,255,255,0.2); }
        .sidebar-user-info { display: flex; align-items: center; margin-bottom: 1rem; }
        .sidebar-user-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; margin-right: 1rem; font-weight: bold; color: var(--primary); }
        
        .row { margin-left: 0 !important; margin-right: 0 !important; }
        .col, [class*="col-"] { padding-left: 15px !important; padding-right: 15px !important; }
    </style>
</head>
<body>
    <!-- Боковое меню -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-rocket-takeoff-fill"></i> FranchiseHub
        </div>
        
        <ul class="sidebar-menu">
            <li><a href="/"><i class="bi bi-house-door-fill"></i> Главная</a></li>
            <li><a href="/Catalog"><i class="bi bi-grid-fill"></i> Каталог франшиз</a></li>
            <li><a href="/Home/About"><i class="bi bi-info-circle"></i> О компании</a></li>
            <li><a href="/Home/Contacts"><i class="bi bi-envelope"></i> Контакты</a></li>
            <li><a href="/Home/News"><i class="bi bi-newspaper"></i> Новости</a></li>
            <li><a href="/Home/Promotions"><i class="bi bi-percent"></i> Акции</a></li>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="mt-4 mb-2 text-white-50 small text-uppercase fw-bold px-3">Личный кабинет</li>
                <li><a href="/Account/Profile"><i class="bi bi-person"></i> Мой профиль</a></li>
                <li><a href="/Order/Index" class="active"><i class="bi bi-card-heading"></i> Мои заявки</a></li>
                <li><a href="/Favorites/Index"><i class="bi bi-heart"></i> Избранное</a></li>
                
                @if (User.IsInRole("Менеджер") || User.IsInRole("Администратор сайта") || User.IsInRole("Администратор"))
                {
                    <li><a href="/Order/Management"><i class="bi bi-list-check"></i> Все заявки</a></li>
                }
                
                @if (User.IsInRole("Администратор сайта") || User.IsInRole("Администратор"))
                {
                    <li class="mt-4 mb-2 text-white-50 small text-uppercase fw-bold px-3">Администрирование</li>
                    <li><a href="/News/Index"><i class="bi bi-newspaper"></i> Управление новостями</a></li>
                    <li><a href="/Admin/Users"><i class="bi bi-people"></i> Управление пользователями</a></li>
                    <li><a href="/Admin/Feedbacks"><i class="bi bi-chat-dots"></i> Управление обратной связью</a></li>
                    <li><a href="/Reviews/Manage"><i class="bi bi-star"></i> Управление отзывами</a></li>
                }
                
                <li class="mt-4"><a href="/Account/Logout"><i class="bi bi-box-arrow-right"></i> Выход</a></li>
            }
            else
            {
                <li class="mt-4"><a href="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Войти</a></li>
                <li><a href="/Account/Register"><i class="bi bi-person-plus"></i> Регистрация</a></li>
            }
        </ul>
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar-user">
                <div class="sidebar-user-info">
                    <div class="sidebar-user-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div>
                        <div class="fw-bold">@User.Identity?.Name</div>
                        <small class="text-white-50">
                            @if (User.IsInRole("Администратор"))
                            {
                                <text>Администратор</text>
                            }
                            else if (User.IsInRole("Администратор сайта"))
                            {

                                <text>Администратор сайта</text>
                            }
                            else if (User.IsInRole("Менеджер"))
                            {

                                <text>Менеджер</text>
                            }
                            else
                            {

                                <text>Пользователь</text>
                            }
                        </small>
                    </div>
                </div>
            </div>
        }
    </aside>

    <div class="main-content">
        <div class="page-header-hero">
            <h1>Мои заявки</h1>
            <div class="subtitle">История ваших обращений к франчайзерам</div>
        </div>

        <section class="orders-section container-fluid">
            <div class="card-custom">
                <h2 class="section-heading">Список заявок</h2>

                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="orders-table">
                            <thead>
                                <tr>
                                    <th>№ Заявки</th>
                                    <th>Франшиза</th>
                                    <th>Регион</th>
                                    <th>Дата подачи</th>
                                    <th>Статус</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><strong>#@item.OrderId</strong></td>
                                        <td>
                                            <div class="fw-bold">@item.Franchise?.Name</div>
                                            <!-- Обрезаем описание если оно длинное -->
                                            @if (item.Franchise?.Description != null && item.Franchise.Description.Length > 30)
                                            {
                                                <small class="text-muted">@item.Franchise.Description.Substring(0, 30)...</small>
                                            }
                                        </td>
                                        <td>@item.Region?.Name</td>
                                        <td>@item.CreatedAt.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            @{
                                                // Логика определения цвета статуса
                                                var statusClass = "status-new";
                                                var statusName = item.OrderStatus?.Name ?? "Новая";
                                                
                                                if (statusName.Contains("В работе", StringComparison.OrdinalIgnoreCase) || statusName.Contains("Обработка", StringComparison.OrdinalIgnoreCase)) 
                                                    statusClass = "status-pending";
                                                else if (statusName.Contains("Одобрено", StringComparison.OrdinalIgnoreCase) || statusName.Contains("Готово", StringComparison.OrdinalIgnoreCase)) 
                                                    statusClass = "status-approved";
                                                else if (statusName.Contains("Отказ", StringComparison.OrdinalIgnoreCase) || statusName.Contains("Закрыто", StringComparison.OrdinalIgnoreCase)) 
                                                    statusClass = "status-rejected";
                                            }
                                            <span class="status-badge @statusClass">@statusName</span>
                                        </td>
                                        <td>
                                            <!-- Ссылка на детали пока ведет на ту же страницу, можно потом настроить -->
                                            <td>
                                            <a asp-controller="Order" asp-action="Details" asp-route-id="@item.OrderId" class="btn-details">Подробнее</a>
                                            </td>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox display-1 text-muted mb-3"></i>
                        <h4 class="fw-bold text-muted">Заявок пока нет</h4>
                        <p class="text-muted">Вы еще не оставили ни одной заявки на франшизу.</p>
                        <a href="/Catalog" class="btn btn-save mt-3">Перейти в каталог</a>
                    </div>
                }
            </div>
        </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>