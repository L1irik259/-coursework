@model IEnumerable<FranchiseAgregator.Models.News>
@{
    Layout = null;
    ViewData["Title"] = "Управление новостями";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root { --primary: #ff6b35; --primary-dark: #e85d2a; --dark: #2d3436; --light: #fdfdfd; --gray: #636e72; --border: #dfe6e9; --sidebar-width: 280px; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--light); color: var(--dark); line-height: 1.6; }
        .sidebar { position: fixed; top: 0; left: 0; width: var(--sidebar-width); height: 100vh; background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; padding: 2rem 0; overflow-y: auto; z-index: 1000; box-shadow: 4px 0 15px rgba(0,0,0,0.1); }
        .sidebar-brand { font-size: 1.75rem; font-weight: 900; text-align: center; margin-bottom: 3rem; padding: 0 1.5rem; }
        .sidebar-brand i { color: #ffd23f; }
        .sidebar-menu { list-style: none; padding: 0 1rem; position: relative; left: -5px; }
        .sidebar-menu li { margin-bottom: 0.5rem; }
        .sidebar-menu a { display: flex; align-items: center; padding: 1rem 1.5rem; color: rgba(255,255,255,0.8); text-decoration: none; border-radius: 12px; transition: all 0.3s ease; font-weight: 600; }
        .sidebar-menu a:hover, .sidebar-menu a.active { background: rgba(255,255,255,0.2); color: white; transform: translateX(5px); }
        .sidebar-menu a i { margin-right: 1rem; font-size: 1.25rem; width: 24px; text-align: center; }
        .main-content { margin-left: var(--sidebar-width); min-height: 100vh; width: calc(100vw - var(--sidebar-width)); padding: 0; }
        .page-header { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); padding: 2rem 4rem; color: white; text-align: center; }
        .page-header h1 { font-size: 2.5rem; font-weight: 900; }
        .content-section { padding: 4rem; width: 100%; }
        .card-custom { background: white; border-radius: 20px; padding: 2rem; box-shadow: 0 8px 25px rgba(0,0,0,0.08); border: 1px solid var(--border); }
        .table-custom { width: 100%; border-collapse: separate; border-spacing: 0 10px; }
        .table-custom th { color: var(--gray); font-weight: 600; text-transform: uppercase; font-size: 0.8rem; padding: 10px 15px; }
        .table-custom td { background: white; padding: 15px; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); vertical-align: middle; }
        .table-custom tr td:first-child { border-radius: 15px 0 0 15px; border-left: 1px solid var(--border); }
        .table-custom tr td:last-child { border-radius: 0 15px 15px 0; border-right: 1px solid var(--border); }
        .status-badge { padding: 6px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; }
        .bg-draft { background: #e2e8f0; color: #475569; }
        .bg-published { background: #dcfce7; color: #166534; }
        .bg-archive { background: #fee2e2; color: #991b1b; }
        .btn-action { padding: 0.4rem 0.8rem; border-radius: 8px; font-size: 0.85rem; margin-right: 8px; border: none; cursor: pointer; transition: 0.2s; }
        .btn-edit { background: #3b82f6; color: white; }
        .btn-action:hover { opacity: 0.9; transform: translateY(-1px); }
        .alert-success { background: #d1fae5; border-left: 4px solid #10b981; color: #065f46; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; }
        .alert-danger { background: #fee2e2; border-left: 4px solid #ef4444; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; }
        .row { margin-left: 0 !important; margin-right: 0 !important; }
        .col, [class*="col-"] { padding-left: 15px !important; padding-right: 15px !important; }
    </style>
</head>
<body>
   <!-- Боковое меню -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-rocket-takeoff-fill"></i> FranchiseHub
        </div>
        
        <ul class="sidebar-menu">
            <li><a href="/"><i class="bi bi-house-door-fill"></i> Главная</a></li>
            <li><a href="/Catalog"><i class="bi bi-grid-fill"></i> Каталог франшиз</a></li>
            <li><a href="/Home/About"><i class="bi bi-info-circle"></i> О компании</a></li>
            <li><a href="/Home/Contacts"><i class="bi bi-envelope"></i> Контакты</a></li>
            <li><a href="/Home/News"><i class="bi bi-newspaper"></i> Новости</a></li>
            <li><a href="/Home/Promotions"><i class="bi bi-percent"></i> Акции</a></li>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="mt-4 mb-2 text-white-50 small text-uppercase fw-bold px-3">Личный кабинет</li>
                <li><a href="/Account/Profile"><i class="bi bi-person"></i> Мой профиль</a></li>
                <li><a href="/Order/Index"><i class="bi bi-card-heading"></i> Мои заявки</a></li>
                <li><a href="/Favorites/Index"><i class="bi bi-heart"></i> Избранное</a></li>
                
                @if (User.IsInRole("Менеджер") || User.IsInRole("Администратор сайта") || User.IsInRole("Администратор"))
                {
                    <li><a href="/Order/Management"><i class="bi bi-list-check"></i> Все заявки</a></li>
                }
                
                @if (User.IsInRole("Администратор сайта") || User.IsInRole("Администратор"))
                {
                    <li class="mt-4 mb-2 text-white-50 small text-uppercase fw-bold px-3">Администрирование</li>
                    <li><a href="/News/Index" class="active"><i class="bi bi-newspaper"></i> Управление новостями</a></li>
                    <li><a href="/Admin/Users"><i class="bi bi-people"></i> Управление пользователями</a></li>
                    <li><a href="/Admin/Feedbacks"><i class="bi bi-chat-dots"></i> Управление обратной связью</a></li>
                    <li><a href="/Reviews/Manage"><i class="bi bi-star"></i> Управление отзывами</a></li>
                }
                
                <li class="mt-4"><a href="/Account/Logout"><i class="bi bi-box-arrow-right"></i> Выход</a></li>
            }
            else
            {
                <li class="mt-4"><a href="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Войти</a></li>
                <li><a href="/Account/Register"><i class="bi bi-person-plus"></i> Регистрация</a></li>
            }
        </ul>
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar-user">
                <div class="sidebar-user-info">
                    <div class="sidebar-user-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div>
                        <div class="fw-bold">@User.Identity?.Name</div>
                        <small class="text-white-50">
                            @if (User.IsInRole("Администратор")) { <text>Администратор</text> }
                            else if (User.IsInRole("Администратор сайта")) { <text>Администратор сайта</text> }
                            else if (User.IsInRole("Менеджер")) { <text>Менеджер</text> }
                            else { <text>Пользователь</text> }
                        </small>
                    </div>
                </div>
            </div>
        }
    </aside>

    <div class="main-content">
        <div class="page-header">
            <h1>Управление новостями</h1>
        </div>

        <section class="content-section container-fluid">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold">Список новостей</h2>
                <a asp-action="Create" class="btn btn-primary px-4 py-2" style="background: var(--primary); border: none; border-radius: 12px; font-weight: 600;">
                    <i class="bi bi-plus-lg me-2"></i>Добавить новость
                </a>
            </div>

            <div class="card-custom">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>Заголовок</th>
                                    <th>Дата</th>
                                    <th>Статус</th>
                                    <th style="width: 200px;">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.Title</div>
                                            <small class="text-muted">@item.Text.Substring(0, Math.Min(50, item.Text.Length))...</small>
                                        </td>
                                        <td>@item.PublishDate.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            @if (item.Status?.Name == "Опубликовано") { <span class="status-badge bg-published">Опубликовано</span> }
                                            else if (item.Status?.Name == "Архив") { <span class="status-badge bg-archive">Архив</span> }
                                            else { <span class="status-badge bg-draft">Черновик</span> }
                                        </td>
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@item.NewsId" class="btn-action btn-edit">
                                                <i class="bi bi-pencil"></i> Изм.
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-newspaper display-1 text-muted mb-3"></i>
                        <h5 class="fw-bold text-muted">Новостей пока нет</h5>
                    </div>
                }
            </div>
        </section>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>